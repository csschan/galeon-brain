# Agent Service Config
PORT=3001

# AI Server (signal source) — your private ai-server instance
AI_SERVER_URL=http://localhost:8080/api
AI_SERVER_STRATEGY=stable

# Solana RPC
# Free: https://api.mainnet-beta.solana.com
# Recommended: Helius, QuickNode, Alchemy
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Drift Protocol environment
DRIFT_ENV=mainnet-beta

# Trade size per signal (USDC)
TRADE_AMOUNT_USDC=100

# DeepSeek LLM — for text intel parsing and reasoning quality analysis
# Get key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Risk limits
MAX_POSITIONS=3
MAX_SINGLE_TRADE_USD=100
DAILY_LOSS_LIMIT_PERCENT=10
